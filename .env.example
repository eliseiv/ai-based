# Template for deploy/instances/<instance>.env before SOPS encryption.
# Copy it, fill real values, encrypt to deploy/instances/<instance>.env.enc,
# then remove the plaintext file.

APP_ENV=prod
LOG_LEVEL=INFO

# --- Instance routing / compose project ---
# INSTANCE_SLUG is used as docker compose project name and as part of Traefik labels.
# For the first existing instance, use the old compose project name to keep using
# the existing Docker volume <project>_pgdata.
INSTANCE_SLUG=client-one
SERVICE_DOMAIN=client-one.example.com

# --- PostgreSQL ---
# Production compose builds DATABASE_URL automatically from these values.
# Do not add DATABASE_URL here for production deploy.
#
# For new instances, use a separate database name and password. A practical rule:
# derive POSTGRES_USER and POSTGRES_DB from INSTANCE_SLUG by replacing '-' with '_'.
POSTGRES_USER=client_one
POSTGRES_PASSWORD=replace-with-unique-strong-password
POSTGRES_DB=client_one
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# API_IMAGE is not stored in instance .env. CI writes it to .env.image on deploy.

# --- Authorization ---
# Single static API key. Send it as `Authorization: Bearer <API_KEY>`.
# Use a unique value per instance.
API_KEY=replace-with-unique-client-bearer-token

# --- OpenAI ---
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_WORDTOOLS_MODEL=gpt-4o-mini
LLM_CHAT_TIMEOUT_SECONDS=20
LLM_WORDTOOLS_TIMEOUT_SECONDS=8
LLM_MAX_INPUT_TOKENS=6000
LLM_MAX_OUTPUT_TOKENS=1024

# --- Chat ---
MAX_MESSAGE_CHARS=8000
HISTORY_MAX_MESSAGES=30
CHAT_SYSTEM_PROMPT=You are a helpful assistant.

# --- Word tools ---
WORD_TOOLS_PROMPTS_DIR=prompts
WORD_TOOLS_DEFAULT_LIMIT=50
WORD_TOOLS_MAX_LIMIT=200

# --- Rate limit ---
# 0 = disabled. If enabled, this is a shared req/min limit for one API_KEY.
RATE_LIMIT_PER_MINUTE=0
RATE_LIMIT_BURST=60
